{
  "name": "mentorib",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:arch": "eslint . && tsx scripts/audit-architectural-rules.ts",
    "lint:arch:test": "tsx scripts/test-architectural-rules.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.8",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.104.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "country-flag-icons": "^1.6.16",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "posthog-js": "^1.372.6",
    "posthog-node": "^5.33.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "4.5.1",
    "stripe": "22.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm tsx scripts/audit-architectural-rules.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
